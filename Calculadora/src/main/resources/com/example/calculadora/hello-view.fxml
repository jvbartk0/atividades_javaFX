<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.calculadora.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Calculadora Básica" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="100" halignment="RIGHT"/>
            <ColumnConstraints minWidth="150"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints minHeight="30"/>
            <RowConstraints minHeight="30"/>
        </rowConstraints>

        <Label text="Número 1:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNum1" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Número 2:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNum2" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="btnSoma" text="+"/>
        <Button fx:id="btnSubtracao" text="-"/>
        <Button fx:id="btnMultiplicacao" text="×"/>
        <Button fx:id="btnDivisao" text="÷"/>
    </HBox>

    <Label fx:id="lblResultado" text="Resultado: " style="-fx-font-size: 14; -fx-text-fill: blue;"/>
</VBox>